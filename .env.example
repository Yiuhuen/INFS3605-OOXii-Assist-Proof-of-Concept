NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Forces the recording screen's admin-only STT diagnostics panel on
# at build time (e.g. for a dedicated QA build). Leave unset for a normal
# demo — the panel is off by default and can also be switched on per-device
# via More -> Admin tools -> "Show STT diagnostics".
NEXT_PUBLIC_SHOW_TRANSCRIPT_DEBUG=
